    "/videos/{publicId}/upload/complete": {
      "post": {
        "description": "Assembles the stored parts, re-checks the real object size, moves the video to 'processing' and enqueues it. Idempotent while the video is 'processing'.",
        "operationId": "VideosController_completeUpload",
        "parameters": [],
        "responses": {
          "202": {
            "description": "Upload completed; the video is now 'processing'",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed publicId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
