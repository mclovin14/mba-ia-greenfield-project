        "type": "string",
        "enum": [
          "uploading",
          "processing",
          "ready",
          "failed"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoStatus"
              }
            ]
          },
          "original_filename": {
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "number"
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true
          },
          "width": {
            "type": "number",
            "nullable": true
          },
          "height": {
            "type": "number",
            "nullable": true
          },
          "video_codec": {
            "type": "string",
            "nullable": true
          },
          "audio_codec": {
            "type": "string",
            "nullable": true
          },
          "container_format": {
            "type": "string",
            "nullable": true
          },
          "processing_error": {
            "type": "string",
            "nullable": true
          },
          "thumbnail_url": {
            "type": "string",
            "nullable": true,
            "description": "Presigned GET URL; non-null only when status is 'ready'"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "public_id",
          "title",
          "description",
          "status",
          "original_filename",
          "mime_type",
          "size_bytes",
          "duration_seconds",
          "width",
          "height",
          "video_codec",
          "audio_codec",
          "container_format",
          "processing_error",
          "thumbnail_url",
          "created_at",
          "updated_at"
        ]
      },
      "UploadPlanDto": {
        "type": "object",
        "properties": {
          "part_size_bytes": {
            "type": "number",
            "example": 16777216
          },
          "part_count": {
            "type": "number",
            "example": 3,
            "maximum": 640
          },
          "max_part_urls_per_request": {
            "type": "number",
            "example": 100
          }
        },
        "required": [
          "part_size_bytes",
          "part_count",
          "max_part_urls_per_request"
        ]
      },
      "InitiateUploadResponseDto": {
        "type": "object",
        "properties": {
          "video": {
            "$ref": "#/components/schemas/VideoResponseDto"
          },
          "upload": {
            "$ref": "#/components/schemas/UploadPlanDto"
          }
        },
        "required": [
          "video",
          "upload"
        ]
      },
      "PartUrlsRequestDto": {
        "type": "object",
        "properties": {}
      },
      "PartUrlDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned UploadPart URL; send the raw part bytes with PUT"
          }
        },
        "required": [
          "part_number",
          "url"
        ]
      },
      "PartUrlsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "description": "In the same order as the requested part_numbers",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartUrlDto"
            }
          },
          "expires_at": {
            "type": "string",
            "example": "2026-10-05T21:00:00.000Z"
          }
        },
        "required": [
          "parts",
          "expires_at"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "size_bytes": {
            "type": "number",
            "example": 16777216
          },
          "etag": {
            "type": "string",
            "example": "\"9b2cf535f27731c974343645a3985328\""
          }
        },
        "required": [
          "part_number",
          "size_bytes",
          "etag"
        ]
      },
      "UploadedPartsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "description": "Ascending by part_number",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "PresignedUrlResponseDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Presigned GET URL; the client fetches the bytes directly from storage"
          },
          "expires_at": {
            "type": "string",
            "example": "2026-10-05T21:00:00.000Z"
          }
        },
        "required": [
          "url",
          "expires_at"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}